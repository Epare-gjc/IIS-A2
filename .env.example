# Copy this file to .env and paste your own key.
# The app reads DEEPSEEK_API_KEY from the environment first, then from .env.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-replace-with-your-own-key

# Optional: override the model (default deepseek-flash)
# DEEPSEEK_MODEL=deepseek-flash
